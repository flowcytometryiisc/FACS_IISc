# Copy these variable names and set real values in Render's Environment settings.
# Do not commit credentials or use this example file as a production secret store.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM_EMAIL=facility@example.edu
ADMIN_NOTIFICATION_EMAIL=facility@example.edu
